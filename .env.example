################################################################################
# card-studio 配置示例
# 拷贝为 .env 后按需填写。.env 已在 .gitignore 中，不会进仓库。
################################################################################

# ─── 基础 ─────────────────────────────────────────────────────────────────────
PORT=3013
# 自定义书架数据目录（默认 ./data）
# CARD_DATA_DIR=/some/abs/path

# ─── LLM provider（cli / mock / http 三选一）─────────────────────────────────
LLM_PROVIDER=http

# http 模式（OpenAI 兼容端点）。下面三个常见配置，留一组即可：
# DeepSeek 官方
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_API_KEY=sk-your-deepseek-key-here
LLM_MODEL=deepseek-chat

# OpenRouter（模型选 deepseek/anthropic/openai 等）
# LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
# LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=deepseek/deepseek-chat

# OpenAI 官方
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4o-mini

# ─── PDF 解析（四选一，按 PDF_PARSE_URL 值判断）──────────────────────────────
#   留空 / local      → 本地 pdf-parse（默认，离线，扫描件抽不出来）
#   http(s)://...     → 自建 V1 解析服务（内网部署）
#   pdf2x             → pdf2x.cn 线上解析（默认 endpoint，下方 PDF2X_API_KEY 必填）
#   local-ppx         → 本地 memect-ppx CLI + OCR（扫描件能出来，慢，需建 venv）
PDF_PARSE_URL=local

# pdf2x.cn 模式才需要
# PDF2X_ENDPOINT=https://insightdoc.memect.cn
# PDF2X_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# local-ppx 模式：默认指向 ./.ppx-venv/bin/ppx；用 PPX_BIN 覆盖到自定义路径
# PPX_BIN=/abs/path/to/ppx
